    %assign/vec4 v0x5dc5c1b9af10_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5dc5c1b86510;
T_1 ;
    %delay 5000, 0;
    %load/vec4 v0x5dc5c1b9b250_0;
    %inv;
    %store/vec4 v0x5dc5c1b9b250_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x5dc5c1b86510;
T_2 ;
