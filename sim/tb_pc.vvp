v0x5dc5c1b9b0e0_0 .net "reset", 0 0, v0x5dc5c1b9b4e0_0;  1 drivers
E_0x5dc5c1b4c520 .event posedge, v0x5dc5c1b9b0e0_0, v0x5dc5c1b4bec0_0;
    .scope S_0x5dc5c1b86740;
T_0 ;
    %wait E_0x5dc5c1b4c520;
    %load/vec4 v0x5dc5c1b9b0e0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x5dc5c1b9af10_0, 0;
    %jmp T_0.1;
T_0.0 ;
