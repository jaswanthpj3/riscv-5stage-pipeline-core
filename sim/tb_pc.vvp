    %vpi_call 2 32 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5dc5c1b86510 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5dc5c1b9b250_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5dc5c1b9b4e0_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5dc5c1b9b3e0_0, 0, 32;
    %delay 12000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5dc5c1b9b4e0_0, 0, 1;
    %delay 10000, 0;
    %load/vec4 v0x5dc5c1b9b310_0;
    %addi 4, 0, 32;
    %store/vec4 v0x5dc5c1b9b3e0_0, 0, 32;
    %delay 10000, 0;
    %load/vec4 v0x5dc5c1b9b310_0;
    %addi 4, 0, 32;
    %store/vec4 v0x5dc5c1b9b3e0_0, 0, 32;
    %delay 10000, 0;
    %load/vec4 v0x5dc5c1b9b310_0;
    %addi 4, 0, 32;
    %store/vec4 v0x5dc5c1b9b3e0_0, 0, 32;
    %delay 10000, 0;
