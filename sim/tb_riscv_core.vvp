    %vpi_call 2 24 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62b0a05a40f0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62b0a05e20e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62b0a05e2180_0, 0, 1;
    %delay 12000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62b0a05e2180_0, 0, 1;
    %delay 200000, 0;
    %vpi_call 2 35 "$display", "-------------------------------------------" {0 0 0};
    %vpi_call 2 36 "$display", "Core Simulation Finished!" {0 0 0};
    %vpi_call 2 37 "$display", "-------------------------------------------" {0 0 0};
    %vpi_call 2 38 "$finish" {0 0 0};
    %end;
    .thread T_17;
